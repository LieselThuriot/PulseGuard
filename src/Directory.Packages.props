<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Azure.Data.Tables" Version="12.13.0" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Azure.Monitor.Query.Logs" Version="1.0.0" />
    <PackageVersion Include="Azure.ResourceManager.AppService" Version="1.5.0" />
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageVersion Include="Azure.Storage.Queues" Version="12.28.1" />
    <PackageVersion Include="FastExpressionCompiler" Version="6.0.0" />
    <PackageVersion Include="MagicConstants" Version="1.0.0-preview-22" />
    <PackageVersion Include="Microsoft.ApplicationInsights.AspNetCore" Version="3.2.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Http.Polly" Version="10.0.14" />
    <PackageVersion Include="Microsoft.OpenApi" Version="2.13.0" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="OpenTelemetry.Api" Version="1.20.1" />
    <PackageVersion Include="Polly" Version="8.9.0" />
    <PackageVersion Include="protobuf-net" Version="3.4.40" />
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.18.5" />
    <PackageVersion Include="SecureWebhooks.SystemTextJson" Version="1.0.1" />
    <PackageVersion Include="Sqids" Version="3.2.1" />
    <PackageVersion Include="TableStorage.Blobs.RuntimeCompilations" Version="6.3.0" />
    <PackageVersion Include="TableStorage.Fluent.RuntimeCompilations" Version="6.3.0" />
    <PackageVersion Include="TableStorage.RuntimeCompilations" Version="6.3.0" />
  </ItemGroup>
  <ItemGroup>
    <GlobalPackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.12.1" PrivateAssets="All" IncludeAssets="Runtime;Build;Native;contentFiles;Analyzers" />
    <GlobalPackageReference Include="AsyncFixer" Version="2.1.0" PrivateAssets="All" IncludeAssets="Runtime;Build;Native;contentFiles;Analyzers" />
    <GlobalPackageReference Include="roslynator.analyzers" Version="5.0.1" PrivateAssets="All" IncludeAssets="Runtime;Build;Native;contentFiles;Analyzers" />
    <GlobalPackageReference Include="Roslynator.Formatting.Analyzers" Version="5.0.1" PrivateAssets="All" IncludeAssets="Runtime;Build;Native;contentFiles;Analyzers" />
  </ItemGroup>
</Project>